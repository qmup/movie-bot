BOT_TOKEN=
# Tuỳ chọn: URL tuyệt đối tới public/watch.html tự host (HTTPS, Content-Type text/html).
# Khi set, nút tập bounce sang streamc kèm Referer (xem đúng tập).
# Khi trống, bot mở trang phim trên phim.nguonc.com (tránh Cloudflare 403).
# Vercel phục vụ public/watch.html ở đường dẫn /xem (rewrite trong vercel.json):
WATCH_BASE_URL=https://movie-bot-five-sigma.vercel.app/xem

# Chỉ cần khi chạy trên Vercel bằng webhook.
TELEGRAM_WEBHOOK_SECRET=

# Bot Zalo: token từ Zalo Bot Manager, secret 8–256 ký tự tự đặt.
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=
